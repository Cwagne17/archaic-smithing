# Application Mode
NEXT_PUBLIC_MOCK_MODE=true

# AWS Amplify Configuration (Production)
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_USER_POOL_ID=your-user-pool-id
NEXT_PUBLIC_USER_POOL_CLIENT_ID=your-user-pool-client-id
NEXT_PUBLIC_API_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com/prod
NEXT_PUBLIC_S3_BUCKET=your-s3-bucket-name

# Additional Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
